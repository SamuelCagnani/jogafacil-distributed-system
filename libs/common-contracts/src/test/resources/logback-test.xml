<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Os testes que exercitam o handler generico disparam logs de erro
         intencionais; silenciamos apenas esse logger para manter a saida limpa. -->
    <logger name="com.jogafacil.contracts.error.GlobalExceptionHandler" level="OFF"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
</configuration>
