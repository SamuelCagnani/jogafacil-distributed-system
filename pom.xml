<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.jogafacil</groupId>
    <artifactId>jogafacil-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>JogaFacil</name>
    <description>JogaFacil - plataforma distribuida de gerenciamento de espacos esportivos e formacao de partidas</description>

    <modules>
        <module>libs/common-contracts</module>
        <module>services/reservation-service</module>
        <module>services/match-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Shared third-party versions (Spring Boot manages the rest) -->
        <aws.sdk.version>2.28.29</aws.sdk.version>
        <ulid-creator.version>5.2.3</ulid-creator.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- AWS SDK for Java v2 (DynamoDB, SNS, SQS) -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Prefixed ULID resource identifiers -->
            <dependency>
                <groupId>com.github.f4b6a3</groupId>
                <artifactId>ulid-creator</artifactId>
                <version>${ulid-creator.version}</version>
            </dependency>

            <!-- Internal shared contracts library -->
            <dependency>
                <groupId>com.jogafacil</groupId>
                <artifactId>common-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
